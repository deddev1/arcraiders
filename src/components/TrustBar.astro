---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const trust = getUi(locale).trust;

const items = [
	{ key: 'status', label: 'Status', value: trust.status, short: trust.statusShort, live: true },
	{ key: 'delivery', label: 'Delivery', value: trust.delivery, short: trust.delivery },
	{ key: 'platform', label: 'Platform', value: trust.platform, short: trust.platform },
	{ key: 'anticheat', label: 'Anti-cheat', value: trust.antiCheatShort, short: trust.antiCheatShort },
] as const;
---

<section class="trust-bar shell" aria-label="Rust Cheats package status">
	<ul class="trust-bar__strip">
		{
			items.map((item) => (
				<li class:list={['trust-bar__item', { 'trust-bar__item--live': item.live }]}>
					<span class="trust-bar__label">{item.label}</span>
					<span class="trust-bar__value">
						{item.live && <span class="trust-bar__dot" aria-hidden="true" />}
						{item.value}
					</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	.trust-bar {
		padding-block: 0.55rem 0.75rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 56px;
	}

	.trust-bar__strip {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.35rem 0;
		margin: 0;
		padding: 0.55rem 1rem;
		list-style: none;
		border-radius: 999px;
		border: 1px solid rgba(168, 85, 247, 0.22);
		background: rgba(26, 22, 38, 0.72);
		box-shadow: none;
	}

	@media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
		.trust-bar__strip {
			animation: trust-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
		}
	}

	.trust-bar__item {
		display: inline-flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.35rem 0.55rem;
		padding: 0.2rem 0.95rem;
		min-width: 0;
	}

	.trust-bar__item:not(:last-child) {
		border-right: 1px solid rgba(168, 85, 247, 0.18);
	}

	.trust-bar__label {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-faint);
	}

	.trust-bar__value {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-ink);
	}

	.trust-bar__item--live .trust-bar__value {
		color: var(--color-mint);
	}

	.trust-bar__dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-mint);
		box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.45);
	}

	@media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
		.trust-bar__dot {
			animation: trust-pulse 2.4s ease-in-out infinite;
		}
	}

	@keyframes trust-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes trust-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.4);
		}
		50% {
			box-shadow: 0 0 0 4px rgba(52, 211, 153, 0);
		}
	}

	@media (max-width: 720px) {
		.trust-bar__strip {
			border-radius: 1rem;
			padding: 0.45rem 0.35rem;
			justify-content: stretch;
		}

		.trust-bar__item {
			flex: 1 1 42%;
			justify-content: center;
			padding: 0.4rem 0.55rem;
			border-right: 0 !important;
		}

		.trust-bar__item:nth-child(odd) {
			border-right: 1px solid rgba(168, 85, 247, 0.14) !important;
		}

		.trust-bar__item:nth-child(-n + 2) {
			border-bottom: 1px solid rgba(168, 85, 247, 0.14);
		}

		.trust-bar__value {
			font-size: 0.78rem;
		}
	}
</style>
