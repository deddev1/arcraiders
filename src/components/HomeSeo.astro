<style>
	.home-seo {
		display: grid;
		gap: 1.5rem;
		padding-bottom: 1rem;
	}

	.card-surface {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(168, 85, 247, 0.16);
		background: rgba(26, 22, 38, 0.72);
	}

	.home-seo h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
	}

	.home-seo p {
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.home-seo ul {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.home-seo li {
		position: relative;
		padding: 0.55rem 0.75rem 0.55rem 1.85rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(168, 85, 247, 0.1);
		background: rgba(10, 6, 18, 0.35);
		color: #d4cae6;
		font-size: 0.94rem;
		line-height: 1.5;
	}

	.home-seo li::before {
		content: '';
		position: absolute;
		left: 0.75rem;
		top: 50%;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.home-seo a {
		color: var(--color-orchid);
		font-weight: 600;
	}

	.home-seo a:hover {
		color: var(--color-ink);
	}

	.home-seo__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.25rem;
	}

	.home-seo__grid article {
		padding: 1rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.35);
	}

	.home-seo__grid h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 750;
	}

	.home-seo__grid p {
		margin-top: 0.45rem;
		font-size: 0.92rem;
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.home-seo__item {
		border-radius: 0.85rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(26, 22, 38, 0.65);
		padding: 0.85rem 1rem;
	}

	.home-seo__item summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--color-ink);
	}

	.home-seo__item p {
		margin-top: 0.65rem;
	}

	.home-seo__more {
		font-size: 0.92rem;
	}

	.home-seo__share {
		padding: clamp(1.1rem, 2.5vw, 1.5rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(18, 16, 26, 0.55);
	}

	.home-seo__share-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.share-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(192, 132, 252, 0.25);
		background: rgba(34, 28, 48, 0.85);
		color: var(--color-ink) !important;
		font-size: 0.88rem;
		font-weight: 700;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.share-link:hover {
		border-color: rgba(192, 132, 252, 0.5);
		background: rgba(48, 36, 72, 0.9);
	}

	@media (max-width: 1024px) {
		.home-seo__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.home-seo {
			gap: 1.1rem;
		}

		.card-surface {
			padding: 1rem;
		}

		.home-seo h2 {
			font-size: clamp(1.2rem, 5.5vw, 1.5rem);
		}

		.home-seo p {
			font-size: 0.92rem;
		}

		.home-seo__grid {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}

		.home-seo__grid article {
			padding: 0.85rem;
		}

		.home-seo__grid h3 {
			font-size: 0.94rem;
			line-height: 1.35;
		}

		.home-seo__grid p {
			font-size: 0.88rem;
		}

		.home-seo__item summary {
			font-size: 0.92rem;
			line-height: 1.4;
			padding-right: 0.5rem;
		}

		.home-seo__share-row {
			flex-direction: column;
		}

		.share-link {
			width: 100%;
			min-height: var(--touch-min);
		}
	}
</style>
